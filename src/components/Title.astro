---
import titleColor from "../assets/title-color.svg";
import type { CollectionEntry } from "astro:content";

interface Props {
  profile: CollectionEntry<"profile">;
  skills: CollectionEntry<"skills">[];
  links: CollectionEntry<"links">[];
}

const { profile, skills, links } = Astro.props;
const { name, role, email } = profile.data;
---

<header class="title">
  <hgroup>
    <h1><img src={titleColor.src} width={titleColor.width} height={titleColor.height} alt={name} /></h1>
    <p class="title-role">{role}</p>
  </hgroup>
  <ul class="title-skills tag-list" aria-label="Skills">
    {skills.map((skill) => <li>{skill.data.name}</li>)}
  </ul>
  <ul class="title-links" aria-label="Links">
    {
      links.map((link) => (
        <li>
          <a class="icon-link" href={link.data.url} style={`--icon: url("${link.data.icon.src}")`}>
            {link.data.label}
          </a>
        </li>
      ))
    }
    <li class="title-email">
      <button type="button" data-email={email}>{email}</button>
    </li>
  </ul>
</header>

<style>
  .title img {
    display: block;
    width: 100%;
    height: auto;
    color: transparent; /* hides placeholder label when loading image */
  }

  .title-role {
    font-size: 2.5rem;
    font-weight: 600;
  }

  .title-links {
    display: flex;
    flex-wrap: wrap;
    column-gap: 1rem;
  }

  .title-email button {
    display: inline-flex;
    align-items: center;
    gap: 0.15em;
    /* strips default button chrome so it reads like the surrounding text */
    padding: 0;
    border: none;
    background: none;
    font: inherit;
    color: inherit;
    cursor: pointer;
  }

  /* masked instead of <img> so the icon follows the text color */
  .title-email button::after {
    content: "";
    width: 1em;
    height: 1em;
    background-color: currentColor;
    mask: url("../assets/icons/copy.svg") center / contain no-repeat;
  }

  .title-email button.copied::after {
    mask-image: url("../assets/icons/check.svg");
  }
</style>

<script>
  const email = document.querySelector<HTMLButtonElement>(".title-email button");
  let timer = 0;

  email?.addEventListener("click", async () => {
    await navigator.clipboard.writeText(email.dataset.email ?? "");
    email.classList.add("copied");

    // restart delay so repeated clicks keep the check up
    clearTimeout(timer);
    timer = setTimeout(() => {
      email.classList.remove("copied");
    }, 5000);
  });
</script>
