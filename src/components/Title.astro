---
import titleColor from "../assets/title-color.svg";
import type { CollectionEntry } from "astro:content";

interface Props {
  profile: CollectionEntry<"profile">;
  links: CollectionEntry<"links">[];
  skills: CollectionEntry<"skills">[];
}

const { profile, links, skills } = Astro.props;
const { name, role, email } = profile.data;
---

<header class="title">
  <h1><img src={titleColor.src} width={titleColor.width} height={titleColor.height} alt={name} /></h1>
  <p class="title-role">{role}</p>
  <p class="title-email">{email}</p>
  <ul class="title-links" aria-label="Links">
    {
      links.map((link) => (
        <li>
          <a href={link.data.url}>{link.data.label}</a>
        </li>
      ))
    }
  </ul>
  <ul class="title-skills pill-list" aria-label="Skills">
    {skills.map((skill) => <li>{skill.data.name}</li>)}
  </ul>
</header>

<style>
  .title img {
    display: block;
    width: 100%;
    height: auto;
    color: transparent; /* hides placeholder label when loading image */
  }

  .title-role {
    font-size: 1.5rem;
    font-weight: 600;
  }

  .title-links {
    font-size: 1.125rem;
    font-weight: 600;
  }
</style>
