---
import ContactLinks from "./ContactLinks.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  profile: CollectionEntry<"profile">;
  links: CollectionEntry<"links">[];
}

const { profile, links } = Astro.props;
const { name, email, repo } = profile.data;

// site rebuilds on every push to main, so the build date is the last update
const updated = new Date();
const updatedText = updated.toLocaleDateString("en-US", { month: "short", year: "numeric" });
---

<footer class="footer">
  <div class="footer-about">
    <p class="footer-credit">Created by {name}.</p>
    <ContactLinks links={links} email={email} />
  </div>
  <p class="footer-source">
    <span>Updated <time datetime={updated.toISOString()}>{updatedText}</time></span>
    <a class="icon-link repo-link" href={repo} aria-label="Portfolio Repo"><span>Repo</span></a>
  </p>
</footer>

<style>
  .footer {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .footer-about {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-credit {
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.2;
    text-wrap: balance;
  }

  .footer-source {
    display: flex;
    gap: 1rem;
    color: var(--color-text-muted);
  }
</style>
