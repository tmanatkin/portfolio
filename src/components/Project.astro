---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { name, description, highlight, repo, website, stack, image } = project.data;
---

<article class="project">
  {/* heading and description already cover image alt text */}
  <Image src={image} alt="" />
  <div class="project-info">
    <h2>{name}</h2>
    <p class="project-description">{description}</p>
    <p class="project-highlight">{highlight}</p>
    <ul class="project-stack pill-list" aria-label="Tech stack">{stack.map((item) => <li>{item}</li>)}</ul>
    <a class="project-repo" href={repo} aria-label={`${name} Repo`}>Repo</a>
    {
      website && (
        <>
          <a class="project-website" href={website} aria-label={`${name} Website`}>
            Visit
          </a>
        </>
      )
    }
  </div>
</article>

<style>
  .project {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 2rem;
  }

  .project img {
    width: 50%;
    height: auto;
    border-radius: 3px;
  }

  .project h2 {
    font-size: 1.75rem;
    line-height: 1.2;
  }

  .project-description,
  .project-highlight {
    min-height: 2lh;
  }

  .project-repo,
  .project-website {
    font-weight: 600;
  }
</style>
