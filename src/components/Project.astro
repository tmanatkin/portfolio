---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { name, description, highlight, repo, website, stack, image } = project.data;
---

<article class="project">
  {/* heading and description already cover image alt text */}
  <Image src={image} alt="" loading="eager" />
  <div class="project-body">
    <div class="project-intro">
      <h2 class="fluid-font">{name}</h2>
      <div class="project-summary fluid-font">
        <p class="project-description">{description}</p>
        <p class="project-highlight">{highlight}</p>
      </div>
    </div>
    <div class="project-meta">
      <ul class="project-stack tag-list fluid-font" aria-label="Tech stack" role="list">
        {stack.map((item) => <li>{item}</li>)}
      </ul>
      <ul class="project-links icon-links fluid-font" aria-label="Links" role="list">
        <li>
          <a class="icon-link repo-link" href={repo} aria-label={`${name} Repo`}>
            <span>Repo</span>
          </a>
        </li>
        {
          website && (
            <li>
              <a class="icon-link website-link" href={website} aria-label={`${name} Website`}>
                <span>Website</span>
              </a>
            </li>
          )
        }
      </ul>
    </div>
  </div>
</article>

<style>
  .project {
    display: flex;
    flex-direction: row;
    gap: 2rem;
    height: 100%;
  }

  .project img {
    align-self: center;
    flex-shrink: 0; /* prevents unloaded image from shrinking */
    width: 50%;
    height: auto;
    border-radius: 3px;
    background-color: var(--color-text); /* fills image space while loading */
    box-shadow: 0 0 20px color-mix(in srgb, var(--color-text) 15%, transparent);
    filter: brightness(0.9); /* tone down bright screenshots */
  }

  .project-body {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .project-intro {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .project h2 {
    --font-size-rem: 1.5;
    font-weight: 600;
    line-height: 1.2;
  }

  .project-summary {
    --font-size-rem: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .project-description {
    color: var(--color-text-muted);
  }

  .project-highlight::before {
    padding-right: 0.5em;
    content: ">"; /* fallback */
    content: ">" / "";
    font-family: var(--font-mono);
    color: var(--color-primary-light);
  }

  .project-meta {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .project-stack {
    --font-size-rem: 0.875;
  }

  .project-links {
    --font-size-rem: 1;
  }

  /* small screen breakpoint */
  @media (width < 70rem) {
    .project {
      flex-direction: column;
    }

    .project img {
      width: 100%;
    }

    .project h2 {
      --min-font-size-rem: 1.375;
    }

    .project-summary,
    .project-links {
      --min-font-size-rem: 0.8125;
    }

    .project-stack {
      --min-font-size-rem: 0.75;
    }
  }
</style>
