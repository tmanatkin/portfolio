---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { name, description, highlight, repo, website, stack, image } = project.data;
---

<article class="project">
  {/* heading and description already cover image alt text */}
  <Image src={image} alt="" />
  <div class="project-body">
    <div class="project-intro">
      <h2>{name}</h2>
      <div class="project-summary">
        <p class="project-description">{description}</p>
        <p class="project-highlight">{highlight}</p>
      </div>
    </div>
    <div class="project-meta">
      <ul class="tag-list" aria-label="Tech stack" role="list">{stack.map((item) => <li>{item}</li>)}</ul>
      <ul class="icon-links" aria-label="Links" role="list">
        <li>
          <a class="icon-link repo-link" href={repo} aria-label={`${name} Repo`}>
            <span>Repo</span>
          </a>
        </li>
        {
          website && (
            <li>
              <a class="icon-link website-link" href={website} aria-label={`${name} Website`}>
                <span>Website</span>
              </a>
            </li>
          )
        }
      </ul>
    </div>
  </div>
</article>

<style>
  .project {
    display: flex;
    flex-direction: row;
    gap: 2rem;
    height: 100%;
  }

  .project img {
    align-self: center;
    flex-shrink: 0; /* prevents unloaded image from shrinking */
    width: 50%;
    height: auto;
    border-radius: 3px;
    box-shadow: 0 0 20px color-mix(in srgb, var(--color-text) 15%, transparent);
    filter: brightness(0.9); /* tone down bright screenshots */
  }

  .project-body {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .project-intro {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .project h2 {
    font-size: 1.75rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .project-summary {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .project-description {
    color: var(--color-text-muted);
  }

  .project-highlight::before {
    padding-right: 0.5em;
    content: ">"; /* fallback */
    content: ">" / "";
    font-family: var(--font-mono);
    color: var(--color-primary-light);
  }

  .project-meta {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
</style>
