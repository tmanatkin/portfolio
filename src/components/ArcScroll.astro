<div class="arc-scroll">
  <div class="arc-scroll-line">
    <div class="arc-scroll-ticks"></div>
    <svg class="arc-scroll-line-svg" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <circle cx="50" cy="50" r="50" vector-effect="non-scaling-stroke"></circle>
    </svg>
  </div>
  <div class="arc-scroll-items">
    <slot />
  </div>
</div>
<div class="arc-scroll-spacer"></div>

<style>
  :global(html) {
    scroll-snap-type: y mandatory;
    overscroll-behavior-y: none;
  }

  .arc-scroll {
    --arc-radius: 200vh;
    --arc-angle: 0.75; /* angle arc is limited to on each side of the center */
    --arc-length: calc(var(--arc-radius) * var(--arc-angle));
    --arc-item-width: min(80%, 55rem);
    --arc-item-gap: 15vh;
    --arc-half-view: 50vh;
  }

  /* arc scroll is fixed to viewport, JS moves items with transform */
  .arc-scroll.enabled {
    position: fixed;
    inset: 0;
  }

  .arc-scroll-items {
    overflow: clip;
    padding-block: var(--arc-half-view); /* padding so the first and last items can reach mid-screen */
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* move snap points to sit right at the scroll edge */
  .arc-scroll-items > :global(.arc-scroll-snap:first-child) {
    translate: 0 -50%;
  }
  .arc-scroll-items > :global(.arc-scroll-snap:last-child) {
    translate: 0 50%;
    margin-top: var(--arc-item-gap);
  }

  /* padding set from the first and last item heights by the script, translating them left an extra half height gap */
  .arc-scroll.enabled .arc-scroll-items {
    padding-block: calc(var(--arc-half-view) - var(--arc-first-half-height))
      calc(var(--arc-half-view) - var(--arc-last-half-height));
  }
  .arc-scroll.enabled .arc-scroll-items > :global(.arc-scroll-snap:first-child) {
    translate: none;
    margin-bottom: var(--arc-item-gap);
  }
  .arc-scroll.enabled .arc-scroll-items > :global(.arc-scroll-snap:last-child) {
    translate: none;
  }

  .arc-scroll-items :global(.arc-scroll-snap) {
    width: var(--arc-item-width);
    scroll-snap-align: center;
  }

  /* scroll snapping used on spacer instead */
  .arc-scroll.enabled .arc-scroll-items :global(.arc-scroll-snap) {
    scroll-snap-align: none;
  }

  .arc-scroll-items :global(.arc-scroll-item) {
    display: flow-root; /* keeps item margins inside snap element so they stay the same size */
    height: 100%; /* fills the snap element */
    transform-origin: calc(-1 * var(--arc-radius)) 50%;
  }

  .arc-scroll.enabled .arc-scroll-items :global(.arc-scroll-item) {
    will-change: transform;
  }

  /* gives the page scroll height and snap points */
  .arc-scroll-spacer {
    position: relative;
    pointer-events: none;
  }

  /* untransformed so scroll flings decelerate into them */
  .arc-scroll-spacer :global(.arc-scroll-snap-point) {
    position: absolute;
    width: 1px;
    height: 2px;
    scroll-snap-align: center;
  }

  .arc-scroll-line {
    --arc-line-gap: calc(var(--arc-item-width) / 16); /* 5vw when items are 80% wide, stops with item max width */
    --arc-line-radius: calc(var(--arc-radius) - var(--arc-line-gap));
    position: sticky; /* keeps the line at mid-screen on the flat page */
    top: 50%;
    height: 0;
  }

  .arc-scroll.enabled .arc-scroll-line {
    position: absolute;
    width: 100%;
  }

  .arc-scroll-line-svg {
    position: absolute;
    top: 0;
    translate: 0 -50%;
    left: calc((100% - var(--arc-item-width)) / 2 - var(--arc-radius) - var(--arc-line-radius));
    width: calc(var(--arc-line-radius) * 2);
    overflow: visible; /* prevent stroke from being clipped */
    fill: none;
    stroke: var(--color-primary);
    stroke-width: 3px;
  }

  /* sits at the arc center so the script can turn every tick at once */
  .arc-scroll-ticks {
    position: absolute;
    top: 0;
    left: calc((100% - var(--arc-item-width)) / 2 - var(--arc-radius));
  }

  .arc-scroll.enabled .arc-scroll-ticks {
    will-change: transform;
  }

  /* placed by the script with a rotate and translate out from the arc center */
  .arc-scroll-ticks :global(.arc-scroll-tick) {
    --tick-width: 1.5px;
    --tick-length: 8px;
    position: absolute;
    top: calc(var(--tick-width) / -2); /* centers the tick on its angle */
    width: var(--tick-length);
    height: var(--tick-width);
    transform-origin: 0 50%;
    background-color: color-mix(in srgb, var(--color-text-muted) 45%, transparent);
  }

  .arc-scroll-ticks :global(.arc-scroll-tick.major) {
    --tick-width: 2px;
    --tick-length: 15px;
    width: var(--tick-length);
    background-color: var(--color-primary-light);
  }
</style>

<script>
  const container = document.querySelector<HTMLElement>(".arc-scroll");
  const items = document.querySelector<HTMLElement>(".arc-scroll-items");
  const spacer = document.querySelector<HTMLElement>(".arc-scroll-spacer");
  const lineSvg = document.querySelector<SVGSVGElement>(".arc-scroll-line-svg");
  const ticks = document.querySelector<HTMLElement>(".arc-scroll-ticks");

  const ticksBetween = 5; // small ticks between each pair of project cards

  const scrollItems: HTMLElement[] = [];
  const scrollItemCenters: number[] = [];
  let arcRadius = 0;
  let arcLength = 0;
  let scrolling = false;

  const supportsScrollEnd = "onscrollend" in window;

  // measure arc and scroll items
  // build spacer height and snap points from them
  function measureScrollItems() {
    if (container === null || items === null || spacer === null || lineSvg === null || ticks === null) {
      throw new Error("ArcScroll: container, items, spacer, line, or ticks not found");
    }

    // enable arc in CSS
    container.classList.add("enabled");

    // clear previous measurements so re-measuring doesn't add duplicates
    scrollItems.length = 0;
    scrollItemCenters.length = 0;
    spacer.replaceChildren();

    // temporary element to convert arc measurements into px
    const temp = document.createElement("div");
    temp.style.position = "absolute";
    temp.style.visibility = "hidden";
    temp.style.width = "var(--arc-radius)";
    temp.style.height = "var(--arc-length)";
    container.appendChild(temp);
    arcRadius = temp.offsetWidth;
    arcLength = temp.offsetHeight;
    temp.remove();

    // first and last item half heights for the padding that centers them at the scroll edges
    const first = items.firstElementChild as HTMLElement;
    const last = items.lastElementChild as HTMLElement;
    items.style.setProperty("--arc-first-half-height", `${first.getBoundingClientRect().height / 2}px`);
    items.style.setProperty("--arc-last-half-height", `${last.getBoundingClientRect().height / 2}px`);

    spacer.style.height = `${items.offsetHeight}px`;

    const itemsTop = items.getBoundingClientRect().top;
    for (const snap of items.querySelectorAll(".arc-scroll-snap")) {
      const rect = snap.getBoundingClientRect();
      const center = rect.top - itemsTop + rect.height / 2;
      scrollItems.push(snap.firstElementChild as HTMLElement);
      scrollItemCenters.push(center);

      const point = document.createElement("div");
      point.className = "arc-scroll-snap-point";
      point.style.top = `${center - 1}px`; // half the point height
      spacer.appendChild(point);
    }

    // ticks share the same radius as arc line
    const tickRadius = lineSvg.getBoundingClientRect().width / 2;

    // most gaps are between project cards, so the middle gap is the card spacing
    const gaps: number[] = [];
    for (let i = 1; i < scrollItemCenters.length; i++) {
      gaps.push(scrollItemCenters[i] - scrollItemCenters[i - 1]);
    }
    gaps.sort((a, b) => a - b);
    const tickSpacing = gaps[Math.floor(gaps.length / 2)] / (ticksBetween + 1);

    // header and footer amount of small ticks are rounded to get the closest spacing to project gaps
    const smallTickCenters: number[] = [];
    for (let i = 1; i < scrollItemCenters.length; i++) {
      const gap = scrollItemCenters[i] - scrollItemCenters[i - 1];
      const intervals = Math.max(1, Math.round(gap / tickSpacing));
      for (let j = 1; j < intervals; j++) {
        smallTickCenters.push(scrollItemCenters[i - 1] + (j * gap) / intervals);
      }
    }

    // major ticks at each snap point
    const majorTickCenters = [...scrollItemCenters];

    // continue ticks past the first and last snap points
    // major ticks past first and last snap points match card spacing
    const firstCenter = scrollItemCenters[0];
    const lastCenter = scrollItemCenters[scrollItemCenters.length - 1];
    const endDistance = window.innerHeight / 2 + tickSpacing;
    for (let step = 1; step * tickSpacing <= endDistance; step++) {
      const distance = step * tickSpacing;
      if (step % (ticksBetween + 1) === 0) {
        majorTickCenters.push(firstCenter - distance);
        majorTickCenters.push(lastCenter + distance);
      } else {
        smallTickCenters.push(firstCenter - distance);
        smallTickCenters.push(lastCenter + distance);
      }
    }

    // major ticks first, then the small ticks
    const tickCenters = [...majorTickCenters, ...smallTickCenters];
    ticks.replaceChildren();
    for (let i = 0; i < tickCenters.length; i++) {
      // angle the tick has at scroll 0, the whole group turns with the scroll after that
      const angle = (tickCenters[i] - window.innerHeight / 2) / arcRadius;

      const tick = document.createElement("div");
      tick.className = i < majorTickCenters.length ? "arc-scroll-tick major" : "arc-scroll-tick";
      // -100% pulls the tick back by its own length so every tick ends at the same radius
      tick.style.transform = `rotate(${angle}rad) translateX(${tickRadius}px) translateX(-100%)`;
      ticks.appendChild(tick);
    }
  }

  // move each scroll item along the arc
  function positionScrollItems() {
    const middleY = window.scrollY + window.innerHeight / 2;

    for (let i = 0; i < scrollItems.length; i++) {
      // items past the arc length stay at the end of the arc
      let distanceFromMiddle = scrollItemCenters[i] - middleY;
      distanceFromMiddle = Math.max(-arcLength, Math.min(arcLength, distanceFromMiddle));

      // distance along the arc converted to an angle in radians
      const angle = distanceFromMiddle / arcRadius;

      // -scrollY scrolls item because container is fixed
      scrollItems[i].style.transform = `translateY(${-window.scrollY - distanceFromMiddle}px) rotate(${angle}rad)`;
    }

    // turn the ticks the same angle the scroll turns the items
    if (ticks !== null) {
      ticks.style.transform = `rotate(${-window.scrollY / arcRadius}rad)`;
    }
  }

  // re-measure and reposition scroll items
  function updateScrollItems() {
    measureScrollItems();
    positionScrollItems();
  }

  // scroll page to keyboard focused element
  function scrollToFocus(event: FocusEvent) {
    const target = event.target as HTMLElement;
    if (!target.matches(":focus-visible")) {
      return;
    }

    const index = scrollItems.indexOf(target.closest<HTMLElement>(".arc-scroll-item") as HTMLElement);
    if (index === -1) {
      return;
    }

    window.scrollTo({ top: scrollItemCenters[index] - window.innerHeight / 2, behavior: "smooth" });
  }

  // step one item per key press
  function scrollByKey(event: KeyboardEvent) {
    if (event.defaultPrevented || event.altKey || event.ctrlKey || event.metaKey) {
      return;
    }

    // space presses a focused button instead of scrolling
    const target = event.target as HTMLElement;
    if (event.key === " " && target.closest("button") !== null) {
      return;
    }

    let step = 0;
    if (event.key === "ArrowDown" || event.key === "PageDown" || (event.key === " " && !event.shiftKey)) {
      step = 1;
    } else if (event.key === "ArrowUp" || event.key === "PageUp" || (event.key === " " && event.shiftKey)) {
      step = -1;
    } else {
      return;
    }
    event.preventDefault();

    // key scrolling is not allowed while mouse scrolling
    if (scrolling) {
      return;
    }

    // step from the item closest to mid-screen
    const middleY = window.scrollY + window.innerHeight / 2;
    let index = 0;
    for (let i = 1; i < scrollItemCenters.length; i++) {
      if (Math.abs(scrollItemCenters[i] - middleY) < Math.abs(scrollItemCenters[index] - middleY)) {
        index = i;
      }
    }
    index = Math.max(0, Math.min(scrollItemCenters.length - 1, index + step));

    window.scrollTo({ top: scrollItemCenters[index] - window.innerHeight / 2, behavior: "smooth" });
  }

  function startScrolling() {
    scrolling = true;
  }

  function endScrolling() {
    scrolling = false;
  }

  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // reduced motion keeps the flat page
  if (!prefersReducedMotion) {
    // place items along arc and move them on scroll
    updateScrollItems();
    window.addEventListener("scroll", positionScrollItems, { passive: true });

    // remeasure on page changes
    window.addEventListener("resize", updateScrollItems);
    window.addEventListener("load", updateScrollItems);
    document.fonts.ready.then(updateScrollItems);

    // tab scrolls to the focused item
    container?.addEventListener("focusin", scrollToFocus);

    // step scroll using keyboard
    window.addEventListener("keydown", scrollByKey);
    if (supportsScrollEnd) {
      window.addEventListener("scroll", startScrolling, { passive: true });
      window.addEventListener("scrollend", endScrolling);
    }
  }
</script>
