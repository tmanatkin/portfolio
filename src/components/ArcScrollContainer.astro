<div class="arc-scroll-container">
  <slot />
</div>
<div class="arc-scroll-spacer"></div>

<style>
  .arc-scroll-container {
    width: 100%;
    height: 100%;
    position: fixed;
    overflow: hidden;
  }

  /* remove scroll items from document flow */
  /* :global() is astros selector to allow global styles outside of component scope */
  .arc-scroll-container > :global(*) {
    position: absolute;
    top: 0;
    left: 0;
    width: 80%; /* width leaves the same margin on the right as contentXRatio leaves on the left */
    transform-origin: 0 0; /* transform-origin at the top left so the script can rotate each item around its rim point */
  }
</style>

<script>
  const container = document.querySelector<HTMLElement>(".arc-scroll-container");
  const spacer = document.querySelector<HTMLElement>(".arc-scroll-spacer");

  // wheel radius as a multiple of the viewport height, bigger is flatter
  const radiusMultiplier = 2;
  // left edge of an item at mid-screen, as a fraction of the viewport width
  const contentXRatio = 0.1;
  // items past this angle are hidden so they never wrap around the wheel
  const maxVisibleAngle = Math.PI / 2;

  const scrollItems: HTMLElement[] = [];
  const scrollItemHeights: number[] = [];
  const scrollItemCenters: number[] = [];

  // measure all scroll items for screen arc placement as spacer height is calculated
  function measureScrollItems() {
    // if no container or spacer, throw error
    if (container === null || spacer === null) {
      throw new Error(`ArcScrollContainer: Container: ${container} or Spacer: ${spacer} not found`);
    }

    // clear previous measurements so re-measuring doesn't add duplicates
    scrollItems.length = 0;
    scrollItemHeights.length = 0;
    scrollItemCenters.length = 0;

    const viewportHeight = window.innerHeight;

    for (const child of container.children) {
      scrollItems.push(child as HTMLElement);
    }

    // if no scroll items, set height to 0 and return
    if (scrollItems.length === 0) {
      spacer.style.height = "0px";
      return;
    }

    // set top of first scroll item
    let scrollItemTop = viewportHeight / 2 - scrollItems[0].offsetHeight / 2;

    for (const scrollItem of scrollItems) {
      const scrollItemHeight = scrollItem.offsetHeight;
      const scrollItemCenter = scrollItemTop + scrollItemHeight / 2;
      scrollItemHeights.push(scrollItemHeight);
      scrollItemCenters.push(scrollItemCenter);
      scrollItemTop = scrollItemTop + scrollItemHeight;
    }

    const lastScrollItemCenter = scrollItemCenters[scrollItemCenters.length - 1];
    spacer.style.height = `${lastScrollItemCenter + viewportHeight / 2}px`;
  }

  // place each scroll item on the wheel's rim based on its distance from the middle of the screen
  function positionScrollItems() {
    const viewportHeight = window.innerHeight;
    const scrollY = window.scrollY;

    // wheel center sits off the left edge, level with the middle of the screen
    const radius = radiusMultiplier * viewportHeight;
    const contentX = contentXRatio * window.innerWidth;
    const wheelCenterX = contentX - radius;
    const wheelCenterY = viewportHeight / 2;

    for (let i = 0; i < scrollItems.length; i++) {
      const distanceFromMiddle = scrollItemCenters[i] - scrollY - viewportHeight / 2;

      // distance along the rim converted to an angle in radians, 0 at the middle of the screen
      const angle = distanceFromMiddle / radius;

      if (Math.abs(angle) > maxVisibleAngle) {
        scrollItems[i].style.visibility = "hidden";
        continue;
      }
      scrollItems[i].style.visibility = "visible";

      // point on the rim where the item's left middle edge sits
      const rimX = wheelCenterX + radius * Math.cos(angle);
      const rimY = wheelCenterY + radius * Math.sin(angle);

      // move to the rim point, tilt with the wheel, then shift up so the item is centered on that point
      const halfHeight = scrollItemHeights[i] / 2;
      scrollItems[i].style.transform =
        `translate(${rimX}px, ${rimY}px) rotate(${angle}rad) translate(0, ${-halfHeight}px)`;
    }
  }

  let isFrameRequested = false;

  // only reposition once per frame, no matter how many scroll events fire
  function handleScroll() {
    if (isFrameRequested) {
      return;
    }

    isFrameRequested = true;
    requestAnimationFrame(() => {
      positionScrollItems();
      isFrameRequested = false;
    });
  }

  let isResizeFrameRequested = false;

  // only re-measure once per frame, no matter how many resize events fire
  function handleResize() {
    if (isResizeFrameRequested) {
      return;
    }

    isResizeFrameRequested = true;
    requestAnimationFrame(() => {
      measureScrollItems();
      positionScrollItems();
      isResizeFrameRequested = false;
    });
  }

  measureScrollItems();
  positionScrollItems();

  // let new scroll functions handle scrolling on actual scroll
  window.addEventListener("scroll", handleScroll, { passive: true });
  window.addEventListener("resize", handleResize);
</script>
