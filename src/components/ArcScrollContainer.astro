<div class="arc-scroll-container">
  <slot />
</div>

<style>
  .arc-scroll-container {
    --arc-radius: 200vh;
    --arc-reach: 150vh; /* ensures animation starts and ends offscreen */
    --arc-angle: 0.75rad; /* item starting rotation (arc-reach / arc-radius) in radians */
    padding-block: 50vh; /* padding so the first and last items can reach mid-screen */
    overflow: clip; /* clip offscreen items without creating a scroll container */
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* :global() is astros selector to allow global styles outside of component scope */
  .arc-scroll-container > :global(*) {
    max-width: 55rem;
    width: 80%;
    transform-origin: calc(-1 * var(--arc-radius)) 50%;
  }

  /* CSS animation if browser supported and no reduced motion */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .arc-scroll-container > :global(*) {
        animation-name: arc-scroll;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: cover calc(50% - var(--arc-reach)) cover calc(50% + var(--arc-reach));
      }
    }
  }

  /* fallback script class additional styles */
  .arc-scroll-fallback > :global(*) {
    will-change: transform;
  }

  @keyframes arc-scroll {
    from {
      transform: translateY(calc(-1 * var(--arc-reach))) rotate(var(--arc-angle));
    }
    to {
      transform: translateY(var(--arc-reach)) rotate(calc(-1 * var(--arc-angle)));
    }
  }
</style>

<script>
  // JS fallback for browsers without CSS scroll-driven animations (Firefox)

  const container = document.querySelector<HTMLElement>(".arc-scroll-container");

  const scrollItems: HTMLElement[] = [];
  const scrollItemCenters: number[] = [];
  let radius = 0;
  let reach = 0;

  // measure the arc settings and each scroll item's center on the page
  function measureScrollItems() {
    if (container === null) {
      throw new Error("ArcScrollContainer: container not found");
    }

    // turn on fallback CSS
    container.classList.add("arc-scroll-fallback");

    // clear previous measurements so re-measuring doesn't add duplicates
    scrollItems.length = 0;
    scrollItemCenters.length = 0;

    for (const child of container.children) {
      scrollItems.push(child as HTMLElement);
    }

    // temporary element to convert arc measurements into px
    const temp = document.createElement("div");
    temp.style.position = "absolute";
    temp.style.visibility = "hidden";
    temp.style.maxWidth = "none"; // clear max-width for accurate radius measurement
    temp.style.width = "var(--arc-radius)";
    temp.style.height = "var(--arc-reach)";
    container.appendChild(temp);
    radius = temp.offsetWidth;
    reach = temp.offsetHeight;
    temp.remove();

    // clear the arc transforms so each item is measured at its normal page position
    for (const scrollItem of scrollItems) {
      scrollItem.style.transform = "";
    }

    for (const scrollItem of scrollItems) {
      const rect = scrollItem.getBoundingClientRect();
      scrollItemCenters.push(rect.top + window.scrollY + rect.height / 2);
    }
  }

  // move each scroll item along the arc
  function positionScrollItems() {
    const middleY = window.scrollY + window.innerHeight / 2;

    for (let i = 0; i < scrollItems.length; i++) {
      // limit the distance to the reach, so items past it stay at the ends of the arc
      let distanceFromMiddle = scrollItemCenters[i] - middleY;
      distanceFromMiddle = Math.max(-reach, Math.min(reach, distanceFromMiddle));

      // distance along the rim converted to an angle in radians
      const angle = distanceFromMiddle / radius;

      scrollItems[i].style.transform = `translateY(${-distanceFromMiddle}px) rotate(${angle}rad)`;
    }
  }

  // re-measure and reposition scroll items
  function updateScrollItems() {
    measureScrollItems();
    positionScrollItems();
  }

  const supportsScrollTimeline = CSS.supports("animation-timeline: view()");
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // run fallback when the CSS scroll animation isn't supported and reduced motion is not on
  if (!supportsScrollTimeline && !prefersReducedMotion) {
    updateScrollItems();
    window.addEventListener("scroll", positionScrollItems, { passive: true });
    window.addEventListener("resize", updateScrollItems);
    window.addEventListener("load", updateScrollItems);
    document.fonts.ready.then(updateScrollItems);
  }
</script>
