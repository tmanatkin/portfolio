---
import nameLogo from "../assets/name-logo.svg";
import ContactLinks from "./ContactLinks.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  profile: CollectionEntry<"profile">;
  skills: CollectionEntry<"skills">[];
  links: CollectionEntry<"links">[];
}

const { profile, skills, links } = Astro.props;
const { name, role, email } = profile.data;
---

<header class="header">
  <hgroup>
    <h1><img src={nameLogo.src} width={nameLogo.width} height={nameLogo.height} alt={name} /></h1>
    <p class="header-role fluid-font">{role}</p>
  </hgroup>
  <ul class="header-skills tag-list fluid-font" aria-label="Skills" role="list">
    {skills.map((skill) => <li>{skill.data.name}</li>)}
  </ul>
  <ContactLinks links={links} email={email} />
</header>

<style>
  .header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .header hgroup {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .header img {
    display: block;
    width: 100%;
    height: auto;
    color: transparent; /* hides placeholder label when loading image */
  }

  .header-role {
    --font-size-rem: 2.5;
    font-weight: 600;
    line-height: 1.2;
    text-wrap: wrap; /* override global set text-wrap pretty */
  }

  .header-skills {
    --font-size-rem: 1.125;
  }

  /* small screen breakpoint */
  @media (width < 70rem) {
    .header-role {
      --font-size-rem: 2;
      --min-font-size-rem: 1.375;
    }

    .header-skills {
      --font-size-rem: 1;
      --min-font-size-rem: 0.75;
    }
  }
</style>
