---
import nameLogo from "../assets/name-logo.svg";
import ContactLinks from "./ContactLinks.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  profile: CollectionEntry<"profile">;
  skills: CollectionEntry<"skills">[];
  links: CollectionEntry<"links">[];
}

const { profile, skills, links } = Astro.props;
const { name, role, email } = profile.data;
---

<header class="header">
  <hgroup>
    <h1><img src={nameLogo.src} width={nameLogo.width} height={nameLogo.height} alt={name} /></h1>
    <p class="header-role">{role}</p>
  </hgroup>
  <ul class="header-skills tag-list" aria-label="Skills" role="list">
    {skills.map((skill) => <li>{skill.data.name}</li>)}
  </ul>
  <ContactLinks links={links} email={email} />
</header>

<style>
  .header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .header hgroup {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .header img {
    display: block;
    width: 100%;
    height: auto;
    color: transparent; /* hides placeholder label when loading image */
  }

  .header-role {
    font-size: 2.5rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .header-skills {
    font-size: 1.125rem;
  }
</style>
