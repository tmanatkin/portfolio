---
import { getCollection, getEntry } from "astro:content";

import Layout from "../layouts/Layout.astro";
import ArcScroll from "../components/ArcScroll.astro";
import ArcScrollSnap from "../components/ArcScrollSnap.astro";
import Header from "../components/Header.astro";
import Project from "../components/Project.astro";
import Footer from "../components/Footer.astro";

const byPosition = (a: { data: { position: number } }, b: { data: { position: number } }) =>
  a.data.position - b.data.position;

const profile = await getEntry("profile", "profile");
if (profile === undefined) {
  throw new Error("Profile entry not found in content.json");
}
const links = (await getCollection("links")).sort(byPosition);
const skills = (await getCollection("skills")).sort(byPosition);
const projects = (await getCollection("projects")).sort(byPosition);
---

<Layout>
  {/* fetch css mask icons early for links to prevent any loading delay */}
  {links.map((link) => <link slot="head" rel="preload" as="image" href={link.data.icon.src} crossorigin="anonymous" />)}
  <ArcScroll>
    <ArcScrollSnap><Header profile={profile} links={links} skills={skills} /></ArcScrollSnap>
    <main>
      {
        projects.map((project) => (
          <ArcScrollSnap>
            <Project project={project} />
          </ArcScrollSnap>
        ))
      }
    </main>
    <ArcScrollSnap><Footer profile={profile} links={links} /></ArcScrollSnap>
  </ArcScroll>
</Layout>

<style>
  /* use grid with fractional units so each project stays the same height */
  main {
    display: grid;
    grid-auto-rows: 1fr;
    justify-items: center;
    gap: var(--arc-item-gap);
    width: 100%;
  }
</style>
