---
import { Font } from "astro:assets";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Full-stack software engineer designing and building web applications with modern frameworks."
    />
    <meta name="color-scheme" content="dark" />
    <Font cssVariable="--font-sora" preload />
    <Font cssVariable="--font-jetbrains-mono" preload />
    <link rel="icon" href="/portfolio/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/portfolio/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/portfolio/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>Tanner Atkin - Full-Stack Software Engineer Portfolio</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
  }

  html {
    --color-bg: #141110;
    --color-text: #e9e3e2;
    --color-text-muted: #beaca7;
    --color-primary: #e53400;
    --color-primary-light: #ff6a2b;
    --color-primary-light-faded: color-mix(in srgb, var(--color-primary-light) 35%, transparent);
    --gradient-primary: linear-gradient(135deg, #e02800 0%, #f25900 100%);
    background-color: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-sora);
  }

  body {
    line-height: 1.5;
    overflow-wrap: break-word;
  }

  :focus-visible {
    outline: 2px solid var(--color-primary-light);
    outline-offset: 3px;
    border-radius: 2px;
  }

  h1,
  h2 {
    text-wrap: balance;
  }

  p {
    text-wrap: pretty;
  }

  ul {
    list-style: none;
    padding: 0;
  }

  .tag-list {
    --item-gap: 1.75em;
    margin-right: calc(-1 * var(--item-gap)); /* cancels trailing margin on each line */
    text-wrap: balance;
    overflow: clip; /* hides separator before first item on each line */
  }

  .tag-list li {
    display: inline-block;
    position: relative;
    margin-right: var(--item-gap);
    font-family: var(--font-jetbrains-mono);
    font-size: 0.875em;
    color: var(--color-text-muted);
  }

  .tag-list li::before {
    position: absolute;
    left: calc(-1 * var(--item-gap) / 2);
    transform: translateX(-50%);
    content: "/"; /* fallback */
    content: "/" / "";
    color: var(--color-primary-light);
  }

  .icon-links {
    display: flex;
    flex-wrap: wrap;
    column-gap: 1rem;
  }

  .icon-link {
    display: inline-flex;
    align-items: center;
    gap: 0.15em;
    text-decoration: none;
    font-weight: 600;
    color: var(--color-primary-light);
  }

  .icon-link span {
    --underline-height: 2px;
    /* solid line starts at 0% and sits on top of faded line */
    background:
      linear-gradient(var(--color-primary-light), var(--color-primary-light)) left bottom / 0% var(--underline-height)
        no-repeat,
      linear-gradient(var(--color-primary-light-faded), var(--color-primary-light-faded)) left bottom / 100%
        var(--underline-height) no-repeat;
    transition: background-size 0.3s ease;
  }

  .icon-link:focus-visible span {
    background-size: 100% var(--underline-height);
  }

  @media (hover: hover) {
    .icon-link:hover span {
      background-size: 100% var(--underline-height);
    }
  }

  /* masked instead of <img> so the icon follows the link's text color */
  .icon-link::before {
    content: "";
    width: 1em;
    height: 1em;
    background-color: currentColor;
    mask: var(--icon, url("../assets/icons/link.svg")) center / contain no-repeat; /* included link as a fallback icon */
  }

  /* global so project and footer repo links share the same icon */
  .repo-link {
    --icon: url("../assets/icons/git.svg");
  }

  .website-link {
    --icon: url("../assets/icons/web.svg");
  }
</style>
