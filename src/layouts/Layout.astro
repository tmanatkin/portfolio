---
import { Font } from "astro:assets";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="dark" />
    <Font cssVariable="--font-sora" preload />
    <Font cssVariable="--font-jetbrains-mono" preload />
    <link rel="icon" href="/portfolio/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/portfolio/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/portfolio/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>Tanner Atkin - Full-Stack Software Engineer Portfolio</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
  }

  html {
    --color-bg: #141110;
    --color-text: #e9e3e2;
    --color-primary: #e53400;
    --gradient-primary: linear-gradient(135deg, #e02800 0%, #f25900 100%);
    background-color: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-sora);
  }

  body {
    line-height: 1.5;
    overflow-wrap: break-word;
  }

  h1,
  h2 {
    text-wrap: balance;
  }

  p {
    text-wrap: pretty;
  }

  ul {
    list-style: none;
    padding: 0;
  }

  .tag-list {
    --item-gap: 2rem;
    margin-right: calc(-1 * var(--item-gap)); /* cancels trailing margin on each line */
    text-wrap: balance;
    overflow: clip; /* hides separator before first item on each line */
  }

  .tag-list li {
    display: inline-block;
    position: relative;
    margin-right: var(--item-gap);
    font-family: var(--font-jetbrains-mono);
    font-size: 0.875rem;
    font-weight: 300;
  }

  .tag-list li::before {
    position: absolute;
    left: calc(-1 * var(--item-gap) / 2);
    transform: translateX(-50%);
    content: "/"; /* fallback */
    content: "/" / "";
    color: var(--color-primary);
  }
</style>
